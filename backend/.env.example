# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# openai/gpt-oss-120b or openai/gpt-oss-20b (faster, cheaper on rate limits)
GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generation limits per signed-in account, so one visitor cannot spend the whole Groq quota.
RATE_LIMIT_PER_HOUR=1
RATE_LIMIT_PER_DAY=50
# MAX_BODY_BYTES=256000

# Set to 1 only to let the app drop and recreate its tables after a schema
# change. Without it a mismatch refuses to start instead of wiping data.
# ALLOW_DB_RESET=1

CLERK_ISSUER=https://your-slug.clerk.accounts.dev
# Run locally without a Clerk account. Never set this on a deployed server.
# AUTH_DEV_BYPASS=1