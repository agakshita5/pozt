# Where the FastAPI backend lives. Server side only, so this address is never
# sent to the browser. On Vercel this is your EC2 instance: http://<elastic-ip>:8000
BACKEND_ORIGIN=http://localhost:8000

# From the Clerk dashboard, API Keys. Required: the app will not run without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
